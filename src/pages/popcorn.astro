---
import Layout from "../layouts/Layout.astro";
import Popcorn from '@lucide/astro/icons/popcorn';
import {consumptionData} from "../lib/loader/popcorn";
import ConsumptionTable from "../components/ConsumptionTable.astro";
---

<Layout title="Popcorn">
  <h1>Popcorn</h1>

  <div class="popcorn-page">
    <section class="popcorn-header-section">
      <p>
        Popcorn is the most tasty food in the world, according to the popcorn
        manufacturing industry. Just look at that:
      </p>

      <div class="centered-image-container">
        <Popcorn size={100}/>
      </div>
    </section>

    <section>
      <h2>Infographs</h2>

      <details>
        <summary>Popcorn consumption</summary>

        <ConsumptionTable consumptionData={consumptionData}/>
      </details>

      <details>
        <summary>Sweet vs Salty</summary>
        CONTENT
      </details>

      <details>
        <summary>Advantages of sweet popcorn</summary>
      </details>
    </section>
  </div>
</Layout>
