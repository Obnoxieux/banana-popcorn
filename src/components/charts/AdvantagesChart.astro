<div>
  <canvas id="advantages-chart"></canvas>
</div>

<script>
  import {Chart, type ChartItem} from "chart.js/auto";

  const canvas = document.getElementById("advantages-chart");

  if (canvas) {
    const data = {
      labels: ["Putin dies", "Dentists get rich", "SUGAR!!!", "Salt is evil", "very German", "Think different"],
      datasets: [{
        label: 'Advantages of sweet popcorn',
        data: [350, 50, 200, 110, 75, 250],
        backgroundColor: [
          'rgba(255, 99, 132, 0.2)',
          'rgba(255, 159, 64, 0.2)',
          'rgba(255, 205, 86, 0.2)',
          'rgba(75, 192, 192, 0.2)',
          'rgba(54, 162, 235, 0.2)',
          'rgba(153, 102, 255, 0.2)',
          'rgba(201, 203, 207, 0.2)'
        ],
        borderColor: [
          'rgb(255, 99, 132)',
          'rgb(255, 159, 64)',
          'rgb(255, 205, 86)',
          'rgb(75, 192, 192)',
          'rgb(54, 162, 235)',
          'rgb(153, 102, 255)',
          'rgb(201, 203, 207)'
        ],
        borderWidth: 1
      }]
    };

    new Chart(canvas as ChartItem, {
      type: 'bar',
      data: data,
      options: {
        scales: {
          y: {
            beginAtZero: true
          }
        }
      },
    });
  }
</script>
